// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"

}

enum Kelamin {
  PRIA
  WANITA
}

// Basic input — data profil user
model User {
  id_user       String    @id @default(uuid())
  username      String
  tanggal_lahir DateTime?
  kelamin       Kelamin?
  created_at    DateTime  @default(now())
  last_updated  DateTime  @updatedAt

  body_metrics  BodyMetrics[]
}

// Advanced input — pengukuran harian body metrics
model BodyMetrics {
  id_bm            String   @id @default(uuid())
  user_id          String

  // Basic input harian
  tb               Float?   // tinggi badan (cm)
  bb               Float?   // berat badan (kg)

  // Advanced input — US Navy method
  lingkar_leher    Float?   // cm
  lingkar_pinggang Float?   // cm (perut/pinggang)
  lingkar_pinggul  Float?   // cm (wanita saja)

  // Hasil kalkulasi US Navy (disimpan ke DB)
  body_fat         Float?   // persentase lemak tubuh (%)

  // Opsional
  catatan          String?  // catatan ringkas

  created_at       DateTime @default(now())
  last_updated     DateTime @updatedAt

  user  User @relation(fields: [user_id], references: [id_user])
}
